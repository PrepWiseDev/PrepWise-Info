# Email capture — Buttondown (https://buttondown.email)
NEXT_PUBLIC_BUTTONDOWN_API_KEY=

# App Store URL (optional override; defaults to the live listing with campaign token)
NEXT_PUBLIC_APP_STORE_URL=

# Meta (Facebook) Pixel ID — Events Manager → Data Sources → your pixel
NEXT_PUBLIC_META_PIXEL_ID=

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX) — optional
NEXT_PUBLIC_GA_MEASUREMENT_ID=
